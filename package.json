{
  "name": "pkstatus",
  "version": "0.13.0-beta.10",
  "description": "Display PluralKit systems and their current status",
  "productName": "PKStatus",
  "homepage": "https://github.com/z0w13/pkstatus",
  "author": "Zowie <git@zowie.cx>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "oxfmt --check && oxlint",
    "typecheck": "vue-tsc --noEmit",
    "format": "oxfmt",
    "dev": "quasar dev",
    "check": "vue-tsc --noEmit",
    "release": "vite-node contrib/release.ts",
    "build": "quasar build",
    "prepare": "husky",
    "test:unit": "vitest",
    "test:unit:ci": "vitest run",
    "postinstall": "quasar prepare"
  },
  "lint-staged": {
    "src/**/*": [
      "oxfmt --check"
    ],
    "src/**/*.{ts,js,cjs,mjs,vue}": [
      "oxlint"
    ]
  },
  "dependencies": {
    "@lumenpink/vue3-fitty": "^0.1.4",
    "axios": "^1.11.0",
    "dayjs": "^1.11.13",
    "markdown-it": "^14.1.0",
    "pinia": "^3.0.3",
    "pinia-plugin-persistedstate": "^4.4.1",
    "pkapi-ts": "^0.3.0",
    "quasar": "^2.18.2",
    "semver": "^7.7.2",
    "vue": "^3.5.18",
    "vue-router": "^5.1.0",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@commander-js/extra-typings": "^14.0.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@quasar/app-vite": "^3.0.1",
    "@quasar/cli": "^5.0.2",
    "@quasar/extras": "^1.17.0",
    "@quasar/icongenie": "^4.0.0",
    "@quasar/vite-plugin": "^1.10.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.10",
    "@types/semver": "^7.7.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vue/test-utils": "^2.4.6",
    "autoprefixer": "^10.4.21",
    "axios-mock-adapter": "^2.1.0",
    "chalk": "^5.5.0",
    "commander": "^14.0.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.4",
    "oxfmt": "^0.58.0",
    "oxlint": "^1.73.0",
    "oxlint-tsgolint": "^0.24.0",
    "postcss-load-config": "^6.0.1",
    "tmp-promise": "^3.0.3",
    "typescript": "^5.9.2",
    "vite-bundle-analyzer": "^1.1.0",
    "vite-node": "^6.0.0",
    "vite-plugin-checker": "^0.10.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4",
    "vue-tsc": "^3.0.5"
  },
  "engines": {
    "node": "^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
